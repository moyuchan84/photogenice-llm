# =========================================================
# Database — asyncpg 직접 사용(ORM 금지). 순수 postgresql:// DSN을 쓴다.
# (config.py가 postgresql+asyncpg:// 접두사도 방어적으로 정규화하지만,
#  새로 쓸 때는 아래처럼 순수 postgresql:// 형태를 권장)
# 포트 5434: docker-compose의 pgvector 컨테이너는 호스트 5434에 매핑되어 있다
# (호스트 5432에 네이티브 PostgreSQL, 5433에 다른 프로젝트의 supabase 컨테이너가 이미
#  떠 있는 환경이 확인되어 충돌 회피 — docker-compose.yml 주석 참고).
# =========================================================
DATABASE_URL=postgresql://asmr:asmr@localhost:5434/asmr_rag

# =========================================================
# Provider 스위치 — 로컬 개발은 ollama, 사내 VM 배포 시 internal로 전환
# =========================================================
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# --- Ollama (로컬 개발/테스트용. 미리 `ollama pull bge-m3`, `ollama pull llama3` 필요) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_LLM_MODEL=llama3

# --- 사내 Embedding API (BGE-M3) — TBD: 엔드포인트/인증/요청·응답 필드명 부서 확인 필요 ---
INTERNAL_EMBEDDING_API_BASE=https://internal-api.company.local/embedding
INTERNAL_EMBEDDING_API_KEY=xxx
INTERNAL_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- 사내 LLM API (Gemma4-260430) — TBD: 엔드포인트/인증/JSON 강제 출력 방식 부서 확인 필요 ---
INTERNAL_LLM_API_BASE=https://internal-api.company.local/llm
INTERNAL_LLM_API_KEY=xxx
INTERNAL_LLM_MODEL=gemma4-260430

# --- ASML API (Phase 4) — TBD: 엔드포인트/인증/응답 필드명 부서 확인 필요.
#     미설정 시 /query/spec-check는 503을 반환한다 ---
ASML_API_BASE=https://asml-backend.internal.company.local
ASML_API_KEY=xxx

# =========================================================
# 임베딩 동기화 워커 / 청킹 파라미터
# (session_gap/error_window 값은 TBD — Phase 5 실측 기반 확정 예정. 아래는 로컬 개발용 임시 기본값)
# =========================================================
EMBEDDING_SYNC_POLL_INTERVAL_SEC=300
EMBEDDING_SYNC_BATCH_SIZE=200
CHUNK_SESSION_GAP_SEC=600
CHUNK_ERROR_WINDOW_BEFORE=5
CHUNK_ERROR_WINDOW_AFTER=5

# --- Spec-check (Phase 3~4에서 사용) ---
SPEC_CHECK_MARGIN_THRESHOLD_PCT=10

# --- HTTP 클라이언트 공통 (httpx + tenacity) ---
EMBEDDING_HTTP_TIMEOUT_SEC=30
LLM_HTTP_TIMEOUT_SEC=60
ASML_HTTP_TIMEOUT_SEC=30
HTTP_RETRY_MAX_ATTEMPTS=3
